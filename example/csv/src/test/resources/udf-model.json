{
  "version": "1.0",
  "defaultSchema": "mysql_db",
  "schemas": [
    {
      "name": "mysql_db",
      "type": "custom",
      "factory": "org.apache.calcite.adapter.jdbc.JdbcSchema$Factory",
      "operand": {
        "jdbcDriver": "com.mysql.cj.jdbc.Driver",
        "jdbcUrl": "jdbc:mysql://localhost:3306/stock_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true",
        "jdbcUser": "root",
        "jdbcPassword": "123456"
      }
    },
    {
      "name": "adhoc",
      "type": "map",
      "functions": [
        {
          "name": "HAS_FRIEND",
          "className": "org.apache.calcite.test.JsonFunctions",
          "methodName": "hasFriend"
        },
        {
          "name": "EXTRACT_NAMES",
          "className": "org.apache.calcite.test.JsonFunctions",
          "methodName": "extractNames"
        }
      ],
      "tables": [
        {
          "name": "USERS_FRIENDS_VIEW",
          "type": "view",
          "sql": "SELECT \"id\", \"name\", \"age\", CAST(\"friends\" AS VARCHAR(2000)) AS \"friends_str\" FROM \"mysql_db\".\"users\"",
          "columns": [
            { "name": "id" },
            { "name": "name" },
            { "name": "age" },
            { "name": "friends_str" }
          ]
        }
      ]
    }
  ]
}
